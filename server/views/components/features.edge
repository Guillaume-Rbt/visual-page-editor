<section class="container px-4 py-5" aria-labelledby="features-{{ title.replaceAll(' ', '-').toLowerCase() }}">
    <div class="row align-items-end mb-4">
        <div class="col-lg-8">
            <h2 id="features-{{ title.replaceAll(' ', '-').toLowerCase() }}" class="pb-2 border-bottom">{{ title }}</h2>
            @if(intro)
                <div class="lead text-muted">{{{ intro }}}</div>
            @endif
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-{{ columns }} g-4">
        @each(item in items)
            <article class="col d-flex align-items-start">
                <div class="d-inline-flex align-items-center justify-content-center flex-shrink-0 me-3 rounded-3 bg-primary text-white"
                    style="width: 3rem; height: 3rem" aria-hidden="true">
                    <span class="fs-5 fw-bold">{{ item.title.charAt(0).toUpperCase() }}</span>
                </div>
                <div>
                    <h3 class="h4 fw-bold mb-1">{{ item.title }}</h3>
                    <div class="text-muted">{{{ item.description }}}</div>
                </div>
            </article>
        @endeach
    </div>
</section>
