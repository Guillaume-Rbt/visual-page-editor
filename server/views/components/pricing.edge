<section class="container py-5" aria-labelledby="pricing-{{ title.replaceAll(' ', '-').toLowerCase() }}">
    <header class="pricing-header p-3 pb-md-4 mx-auto text-center">
        <h2 id="pricing-{{ title.replaceAll(' ', '-').toLowerCase() }}" class="display-4 fw-normal">{{ title }}</h2>
        @if(intro)
            <div class="fs-5 text-muted">{{{ intro }}}</div>
        @endif
    </header>

    <div class="row row-cols-1 row-cols-md-{{ columns }} mb-3 text-center g-4 justify-content-center">
        @each(plan in plans)
            <article class="col">
                <div class="card h-100 rounded-3 shadow-sm {{ plan.highlighted ? 'border-primary' : '' }}">
                    <div class="card-header py-3 {{ plan.highlighted ? 'text-white bg-primary border-primary' : '' }}">
                        <h3 class="my-0 h4 fw-normal">{{ plan.name }}</h3>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <p class="card-title mb-3">
                            <span class="display-5 fw-bold">{{ currency }}{{ plan.price }}</span>
                            <span class="text-muted fw-light">{{ plan.period }}</span>
                        </p>
                        <ul class="list-unstyled mt-1 mb-4">
                            @each(feature in plan.features)
                                <li class="mb-1">{{ feature.label }}</li>
                            @endeach
                        </ul>
                        <a href="{{ plan.buttonUrl }}"
                            class="mt-auto w-100 btn btn-lg {{ plan.highlighted ? 'btn-primary' : 'btn-outline-primary' }}">
                            {{ plan.buttonLabel }}
                        </a>
                    </div>
                </div>
            </article>
        @endeach
    </div>
</section>
